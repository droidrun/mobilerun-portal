 <Button android:id="@+id/capture" style="@style/TVButton" android:layout_width="match_parent" android:text="@string/tv_allow" android:nextFocusUp="@id/accessibility" android:nextFocusDown="@id/notifications" android:nextFocusLeft="@id/newCode" android:nextFocusRight="@id/newCode"/>
 </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="6dp" android:clipChildren="false" android:clipToPadding="false">
 <TextView style="@style/TVText" android:text="@string/tv_notifications_label" android:textSize="18sp" android:textFontWeight="500"/>
 <TextView android:id="@+id/notificationStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="@font/geist_sans" android:paddingHorizontal="10dp" android:paddingVertical="0dp" android:layout_marginTop="3dp"/>
 <Button android:id="@+id/notifications" style="@style/TVButton" android:layout_width="match_parent" android:text="@string/tv_open_settings" android:nextFocusUp="@id/capture" android:nextFocusDown="@id/newCode" android:nextFocusLeft="@id/newCode" android:nextFocusRight="@id/newCode"/>
 <TextView android:id="@+id/notificationHint" style="@style/TVHint" android:maxLines="1"/></LinearLayout>
   </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/message" style="@style/TVText" android:textSize="16sp" android:textColor="@color/tv_muted_foreground" android:accessibilityLiveRegion="polite" android:visibility="gone" android:maxLines="2" android:layout_marginTop="8dp"/>
